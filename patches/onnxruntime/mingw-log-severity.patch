+#define LOGS_CATEGORY_SEV(logger, sev, category)                                                                 \
+  if (!(logger).OutputIsEnabled(sev, ::onnxruntime::logging::DataType::SYSTEM)) {                               \
+    /* do nothing */                                                                                             \
+  } else                                                                                                         \
+    ::onnxruntime::logging::Capture(logger, sev, category, ::onnxruntime::logging::DataType::SYSTEM, ORT_WHERE) \
+        .Stream()
+
+#define LOGS_USER_CATEGORY_SEV(logger, sev, category)                                                          \
+  if (!(logger).OutputIsEnabled(sev, ::onnxruntime::logging::DataType::USER)) {                               \
+    /* do nothing */                                                                                           \
+  } else                                                                                                       \
+    ::onnxruntime::logging::Capture(logger, sev, category, ::onnxruntime::logging::DataType::USER, ORT_WHERE) \
+        .Stream()
+
+#define LOGF_CATEGORY_SEV(logger, sev, category, format_str, ...)                                                      \
+  do {                                                                                                                 \
+    if ((logger).OutputIsEnabled(sev, ::onnxruntime::logging::DataType::SYSTEM))                                       \
+      ::onnxruntime::logging::Capture(logger, sev, category, ::onnxruntime::logging::DataType::SYSTEM, ORT_WHERE)      \
+          .CapturePrintf(format_str, ##__VA_ARGS__);                                                                   \
+  } while (0)
+
+#define LOGF_USER_CATEGORY_SEV(logger, sev, category, format_str, ...)                                               \
+  do {                                                                                                               \
+    if ((logger).OutputIsEnabled(sev, ::onnxruntime::logging::DataType::USER))                                       \
+      ::onnxruntime::logging::Capture(logger, sev, category, ::onnxruntime::logging::DataType::USER, ORT_WHERE)      \
+          .CapturePrintf(format_str, ##__VA_ARGS__);                                                                 \
+  } while (0)
