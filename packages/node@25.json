{
    "package": "node@25",
    "version": "25.1.0",
    "type": "host",
    "download": [
        {
            "kind": "git",
            "sha256": "1da054d99bb16d35c54d759f36ccc125b90070bd",
            "url": "https://github.com/nodejs/node.git"
        }
    ],
    "dependencies": [
        "*:*:native/_",
        "*:*:native/ninja",
        "*:*:native/python@3.14"
    ],
    "patches": [
        "fallback.c"
    ],
    "build": {
        "env": [
            "*:*:GYP_LINK_CONCURRENCY=$NUM_CORES",
            "*:*:config_opts=--ninja",
            "*:*:config_opts=$config_opts --prefix=$PREFIX"
        ],
        "steps": [
            "linux_amd64:x86_64-linux-gnu:env -u CC_target ./configure $config_opts",
            "linux_amd64:x86_64-linux-gnu:ninja -C out/Release -j$NUM_CORES",
            "linux_amd64:x86_64-linux-gnu:python3 tools/install.py install --dest-dir $STAGING_DIR --prefix $PREFIX",
            "linux_arm64:aarch64-linux-gnu:env -u CC_target ./configure $config_opts",
            "linux_arm64:aarch64-linux-gnu:ninja -C out/Release -j$NUM_CORES",
            "linux_arm64:aarch64-linux-gnu:python3 tools/install.py install --dest-dir $STAGING_DIR --prefix $PREFIX",
            "darwin_arm64:*-apple-darwin:env -u CC_target ./configure $config_opts",
            "darwin_arm64:*-apple-darwin:ninja -C out/Release -j$NUM_CORES",
            "darwin_arm64:*-apple-darwin:python3 tools/install.py install --dest-dir $STAGING_DIR --prefix $PREFIX"
        ]
    }
}