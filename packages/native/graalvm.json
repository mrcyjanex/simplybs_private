        "steps": [
            "linux_amd64:*:mkdir -p .graal-tools",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/sysroot/lib/x86_64-linux-gnu/libc.so.6 .graal-tools/ldd",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-objdump .graal-tools/objdump",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-nm .graal-tools/nm",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-ar .graal-tools/ar",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-cxxfilt .graal-tools/c++filt",
            "linux_amd64:*:cp $PATCH_DIR/jdk/which .graal-tools/which",
            "linux_amd64:*:chmod +x .graal-tools/which",
            "linux_amd64:*:sed -e \"s#@CLANG21@#$NATIVEPREFIX/_/bin/clang-21#g\" -e \"s#@DRV@##g\" -e \"s#@SYSROOT@#$NATIVEPREFIX/_/sysroot#g\" -e \"s#@DUMPMACHINE@#x86_64-linux-gnu#g\" $PATCH_DIR/graalvm/cc > .graal-tools/gcc",
            "linux_amd64:*:sed -e \"s#@CLANG21@#$NATIVEPREFIX/_/bin/clang-21#g\" -e \"s#@DRV@#--driver-mode=g++#g\" -e \"s#@SYSROOT@#$NATIVEPREFIX/_/sysroot#g\" -e \"s#@DUMPMACHINE@#x86_64-linux-gnu#g\" $PATCH_DIR/graalvm/cc > .graal-tools/g++",
            "linux_amd64:*:chmod +x .graal-tools/gcc .graal-tools/g++",
            "linux_amd64:*:cp .graal-tools/gcc $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/gcc",
            "linux_amd64:*:cp .graal-tools/g++ $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/g++",
            "linux_amd64:*:cp .graal-tools/gcc $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/x86_64-linux-gnu-gcc",
            "linux_amd64:*:cp .graal-tools/g++ $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/x86_64-linux-gnu-g++",
            "linux_arm64:*:mkdir -p .graal-tools",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/sysroot/lib/aarch64-linux-gnu/libc.so.6 .graal-tools/ldd",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-objdump .graal-tools/objdump",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-nm .graal-tools/nm",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-ar .graal-tools/ar",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-cxxfilt .graal-tools/c++filt",
            "linux_arm64:*:cp $PATCH_DIR/jdk/which .graal-tools/which",
            "linux_arm64:*:chmod +x .graal-tools/which",
            "linux_arm64:*:sed -e \"s#@CLANG21@#$NATIVEPREFIX/_/bin/clang-21#g\" -e \"s#@DRV@##g\" -e \"s#@SYSROOT@#$NATIVEPREFIX/_/sysroot#g\" -e \"s#@DUMPMACHINE@#aarch64-linux-gnu#g\" $PATCH_DIR/graalvm/cc > .graal-tools/gcc",
            "linux_arm64:*:sed -e \"s#@CLANG21@#$NATIVEPREFIX/_/bin/clang-21#g\" -e \"s#@DRV@#--driver-mode=g++#g\" -e \"s#@SYSROOT@#$NATIVEPREFIX/_/sysroot#g\" -e \"s#@DUMPMACHINE@#aarch64-linux-gnu#g\" $PATCH_DIR/graalvm/cc > .graal-tools/g++",
            "linux_arm64:*:chmod +x .graal-tools/gcc .graal-tools/g++",
            "darwin_arm64:*:mkdir -p .graal-tools",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-objdump .graal-tools/objdump",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-nm .graal-tools/nm",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-ar .graal-tools/ar",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-cxxfilt .graal-tools/c++filt",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-libtool-darwin .graal-tools/libtool",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-lipo .graal-tools/lipo",
            "darwin_arm64:*:cp $PATCH_DIR/jdk/which .graal-tools/which",
            "darwin_arm64:*:chmod +x .graal-tools/which",
            "darwin_arm64:*:cp $PATCH_DIR/rust-std/xcrun .graal-tools/xcrun",
            "darwin_arm64:*:chmod +x .graal-tools/xcrun",
            "darwin_arm64:*:printf '#!/bin/sh\\ncase \"$1\" in\\n  -productVersion) echo %s ;;\\n  *) echo %s ;;\\nesac\\n' \"$SDK_VERSION\" \"$SDK_VERSION\" > .graal-tools/sw_vers",
            "darwin_arm64:*:chmod +x .graal-tools/sw_vers",
            "darwin_arm64:*:sed -e \"s#@CLANG21@#$NATIVEPREFIX/_/bin/clang-21#g\" -e \"s#@DRV@##g\" -e \"s#@SYSROOT@#$NATIVEPREFIX/_/SDK/MacOSX26.1.sdk#g\" -e \"s#@DUMPMACHINE@#arm64-apple-darwin#g\" $PATCH_DIR/graalvm/cc > .graal-tools/gcc",
            "darwin_arm64:*:sed -e \"s#@CLANG21@#$NATIVEPREFIX/_/bin/clang-21#g\" -e \"s#@DRV@#--driver-mode=g++#g\" -e \"s#@SYSROOT@#$NATIVEPREFIX/_/SDK/MacOSX26.1.sdk#g\" -e \"s#@DUMPMACHINE@#arm64-apple-darwin#g\" $PATCH_DIR/graalvm/cc > .graal-tools/g++",
            "darwin_arm64:*:chmod +x .graal-tools/gcc .graal-tools/g++",
            "darwin_arm64:*:cp .graal-tools/gcc $NATIVEPREFIX/bin/gcc",
            "darwin_arm64:*:cp .graal-tools/g++ $NATIVEPREFIX/bin/g++",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-ar $NATIVEPREFIX/bin/ar",
            "darwin_arm64:*:cp .graal-tools/xcrun $NATIVEPREFIX/bin/xcrun",
            "darwin_arm64:*:cp .graal-tools/sw_vers $NATIVEPREFIX/bin/sw_vers",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-libtool-darwin $NATIVEPREFIX/bin/libtool",
            "darwin_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-lipo $NATIVEPREFIX/bin/lipo",
            "darwin_arm64:*:sed \"s|@LD64_LLD@|$NATIVEPREFIX/_/bin/lld|g; s|@SDK_VERSION@|$SDK_VERSION|g\" $PATCH_DIR/native/osx-cross/classic-ld-wrapper.sh > $NATIVEPREFIX/bin/ld",
            "darwin_arm64:*:chmod +x $NATIVEPREFIX/bin/ld",
            "*:*:patch -p1 < $PATCH_DIR/graalvm/disable-exec-static-tramp.patch",
            "*:*:patch -p1 -d mx < $PATCH_DIR/graalvm/mx-file-digest.patch",
            "*:*:patch -p1 -d mx < $PATCH_DIR/graalvm/mx-skip-unused.patch",
            "*:*:sed -i 's|\"https://repo1.maven.org/maven2/\",|\"file://'$NATIVEPREFIX'/share/maven/repository/\", \"https://repo1.maven.org/maven2/\",|' mx/src/mx/_impl/mx.py",
            "*:*:find . -path ./mx/tests -prune -o -name suite.py -exec sed -i /sourceDigest/d {} +",
            "*:*:find . -path ./mx/tests -prune -o -name suite.py -exec sed -i /sourceSha1/d {} +",
            "*:*:sed -i 's|\"JLINE_READER\": {|\"JLINE_READER\": { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/org/jline/jline-reader/3.23.0/jline-reader-3.23.0-sources.jar\",|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"JLINE_TERMINAL\": {|\"JLINE_TERMINAL\": { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/org/jline/jline-terminal/3.23.0/jline-terminal-3.23.0-sources.jar\",|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"JLINE_BUILTINS\": {|\"JLINE_BUILTINS\": { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/org/jline/jline-builtins/3.23.0/jline-builtins-3.23.0-sources.jar\",|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"ICU4J\" : {|\"ICU4J\" : { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/com/ibm/icu/icu4j/74.1/icu4j-74.1-sources.jar\",|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|\"ICU4J-CHARSET\" : {|\"ICU4J-CHARSET\" : { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/com/ibm/icu/icu4j-charset/74.1/icu4j-charset-74.1-sources.jar\",|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|\"XZ-1.9\" : {|\"XZ-1.9\" : { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/org/tukaani/xz/1.9/xz-1.9-sources.jar\",|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|\"JSON\" : {|\"JSON\" : { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/org/json/json/20231013/json-20231013-sources.jar\",|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|\"ANTLR4\": {|\"ANTLR4\": { \"sourcePath\": \"'$NATIVEPREFIX'/share/maven/repository/org/antlr/antlr4-runtime/4.12.0/antlr4-runtime-4.12.0-sources.jar\",|' truffle/mx.truffle/suite.py",
            "*:*:mkdir -p $NATIVEPREFIX/share/maven/repository/junit/junit/4.12",
            "*:*:cp $NATIVEPREFIX/share/maven/repository/junit/junit/4.13.2/junit-4.13.2.jar $NATIVEPREFIX/share/maven/repository/junit/junit/4.12/junit-4.12.jar",
            "*:*:sed -i 's|\"{host}/llvm-llvmorg-[^\"]*\"|\"file://'$NATIVEPREFIX'/share/llvm-16.0.1/llvm-org.tar.gz\"|g' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"{host}/llvm-lldonly-llvmorg-[^\"]*\"|\"file://'$NATIVEPREFIX'/share/llvm-16.0.1/llvm-org.tar.gz\"|' substratevm/mx.substratevm/suite.py",
            "*:*:mkdir -p .dummy-hsdis",
            "*:*:echo stub > .dummy-hsdis/hsdis.dylib",
            "*:*:$MX_PYTHON -c 'import tarfile; t=tarfile.open(\"hsdis-stub.tar.gz\",\"w:gz\"); t.add(\".dummy-hsdis/hsdis.dylib\", arcname=\"hsdis.dylib\"); t.close()'",
            "*:*:sed -i 's|{urlbase}/hsdis-aarch64-darwin-[^\"]*|file://'$PWD'/hsdis-stub.tar.gz|' compiler/mx.compiler/suite.py",
            "*:*:sed -i 's|\"LLVM_ORG_COMPILER_RT_LINUX\" : {|\"LLVM_ORG_COMPILER_RT_LINUX\" : { \"optional\": True, \"path\": \"missing-llvm-compiler-rt-linux\",|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"LLVM_ORG_SRC\" : {|\"LLVM_ORG_SRC\" : { \"optional\": True, \"path\": \"missing-llvm-org-src\",|' sdk/mx.sdk/suite.py",
            "*:*:sed -i '/extracted-dependency:LLVM_ORG_COMPILER_RT_LINUX/d' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"LLVM_NINJA_TOOLCHAIN\": {|\"LLVM_NINJA_TOOLCHAIN\": { \"defaultBuild\": False,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"org.graalvm.toolchain.test\" : {|\"org.graalvm.toolchain.test\" : { \"defaultBuild\": False,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|https://lafo.ssw.uni-linz.ac.at/pub/graal-external-deps/libffi-{version}.tar.gz|file://'$PWD'/libffi-3.4.4.tar.gz|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|https://github.com/libffi/libffi/releases/download/v{version}/libffi-{version}.tar.gz|file://'$PWD'/libffi-3.4.4.tar.gz|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|https://lafo.ssw.uni-linz.ac.at/pub/graal-external-deps/graalvm-shadowed-jcodings-{version}.jar|file://'$NATIVEPREFIX'/share/graal-external-deps/graalvm-shadowed-jcodings-1.0.58.1.jar|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|https://lafo.ssw.uni-linz.ac.at/pub/graal-external-deps/com.oracle.truffle.api.impl.asm-9.5.0.jar|file://'$NATIVEPREFIX'/share/graal-external-deps/com.oracle.truffle.api.impl.asm-9.5.0.jar|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|https://lafo.ssw.uni-linz.ac.at/pub/graal-external-deps/antlr-4.12.0-complete.jar|file://'$NATIVEPREFIX'/share/graal-external-deps/antlr-4.12.0-complete.jar|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|\"com.oracle.mxtool.jacoco\" : {|\"com.oracle.mxtool.jacoco\" : { \"defaultBuild\": False,|' mx/mx.mx/suite.py",
            "*:*:sed -i 's|\"MX_JACOCO_REPORT\" : {|\"MX_JACOCO_REPORT\" : { \"defaultBuild\": False,|' mx/mx.mx/suite.py",
            "*:*:mkdir -p .libffi-src",
            "*:*:$MX_PYTHON -c 'import tarfile; tarfile.open(\"libffi-3.4.4.tar.gz\").extractall(\".libffi-src\")'",
            "*:*:patch -p1 -d .libffi-src/libffi-3.4.4 < $PATCH_DIR/graalvm/libffi-aarch64-cfi.patch",
            "*:*:$MX_PYTHON -c 'import tarfile; t=tarfile.open(\"libffi-3.4.4.tar.gz\",\"w:gz\"); t.add(\".libffi-src/libffi-3.4.4\", arcname=\"libffi-3.4.4\"); t.close()'",
            "*:*:sed -i 's|https://lafo.ssw.uni-linz.ac.at/pub/graal-external-deps/ninja_syntax-1.7.2.tar.gz|file://'$PWD'/ninja_syntax-1.7.2.tar.gz|' mx/mx.mx/suite.py",
            "*:*:cp $PATCH_DIR/graalvm/ce.env vm/mx.vm/simplybs",
            "*:*:$JAVA_HOME/bin/java -version",
            "*:*:mx/mx --version",
            "linux_amd64:*:cd vm && CPLUS_INCLUDE_PATH=$(echo $NATIVEPREFIX/_/include/c++/*):$(echo $NATIVEPREFIX/_/include/c++/*)/x86_64-linux-gnu LIBRARY_PATH=$NATIVEPREFIX/_/sysroot/lib ../mx/mx --java-home $JAVA_HOME --env simplybs build",
            "linux_arm64:*:cd vm && CPLUS_INCLUDE_PATH=$(echo $NATIVEPREFIX/_/include/c++/*):$(echo $NATIVEPREFIX/_/include/c++/*)/aarch64-linux-gnu LIBRARY_PATH=$NATIVEPREFIX/_/sysroot/lib ../mx/mx --java-home $JAVA_HOME --env simplybs build",
            "darwin_arm64:*:cd vm && ../mx/mx --java-home $JAVA_HOME --env simplybs build",
            "*:*:cd vm && ../mx/mx --java-home $JAVA_HOME --env simplybs graalvm-home > ../.graalvm-home",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/graalvm $STAGING_DIR$NATIVEPREFIX/bin",
            "*:*:cp -a $(cat .graalvm-home)/. $STAGING_DIR$NATIVEPREFIX/graalvm/",
            "*:*:sed -e s/@TOOL@/java/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/java",
            "*:*:sed -e s/@TOOL@/javac/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/javac",
            "*:*:sed -e s/@TOOL@/jar/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/jar",
            "*:*:sed -e s/@TOOL@/native-image/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/native-image",
            "*:*:chmod +x $STAGING_DIR$NATIVEPREFIX/bin/java $STAGING_DIR$NATIVEPREFIX/bin/javac $STAGING_DIR$NATIVEPREFIX/bin/jar $STAGING_DIR$NATIVEPREFIX/bin/native-image",
            "*:*:$STAGING_DIR$NATIVEPREFIX/graalvm/bin/java -version",
            "*:*:$STAGING_DIR$NATIVEPREFIX/graalvm/bin/native-image --version"
        ]
    }
}