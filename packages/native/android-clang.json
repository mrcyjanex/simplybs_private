{
    "package": "native/android-clang",
    "version": "21.1.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "450f52eec88f728c89a9efd667dbeaf2dad93826",
            "url": "https://github.com/llvm/llvm-project"
        }
    ],
    "dependencies": [
        "*:*-android*:native/_/_",
        "*:*-android*:native/bash",
        "*:*-android*:native/cmake",
        "*:*-android*:native/libc++",
        "*:*-android*:native/ninja",
        "*:*-android*:native/python@3.11",
        "*:*-android*:native/zlib"
    ],
    "build": {
        "env": [
            "*:*-android*:config_opts=-G Ninja -S llvm -B build",
            "*:*-android*:config_opts=$config_opts -DCMAKE_BUILD_TYPE=Release",
            "*:*-android*:config_opts=$config_opts -DCMAKE_INSTALL_PREFIX=$NATIVEPREFIX/android-clang",
            "*:*-android*:config_opts=$config_opts -DLLVM_ENABLE_PROJECTS='clang;lld'",
            "*:*-android*:config_opts=$config_opts -DLLVM_INCLUDE_TESTS=OFF",
            "*:*-android*:config_opts=$config_opts -DLLVM_INCLUDE_BENCHMARKS=OFF",
            "*:*-android*:config_opts=$config_opts -DLLVM_ENABLE_ASSERTIONS=OFF",
            "*:*-android*:config_opts=$config_opts -DLLVM_ENABLE_ZSTD=OFF",
            "*:*-android*:config_opts=$config_opts -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON",
            "*:*-android*:config_opts=$config_opts -DLLVM_INSTALL_BINUTILS_SYMLINKS=ON",
            "*:*-android*:config_opts=$config_opts -DLLVM_TOOLCHAIN_TOOLS='dsymutil;llvm-ar;llvm-as;llvm-config;llvm-cov;llvm-cxxfilt;llvm-dlltool;llvm-dwp;llvm-ifs;llvm-lib;llvm-link;llvm-lipo;llvm-ml;llvm-nm;llvm-objcopy;llvm-objdump;llvm-profdata;llvm-ranlib;llvm-rc;llvm-readobj;llvm-size;llvm-strings;llvm-strip;llvm-symbolizer;llvm-windres'",
            "*:*-android*:config_opts=$config_opts -DCLANG_DEFAULT_LINKER=lld",
            "*:*-android*:config_opts=$config_opts -DCLANG_DEFAULT_RTLIB=compiler-rt",
            "*:*-android*:config_opts=$config_opts -DCLANG_DEFAULT_UNWINDLIB=libunwind",
            "*:*-android*:config_opts=$config_opts -DCLANG_DEFAULT_CXX_STDLIB=libc++",
            "*:*-android*:config_opts=$config_opts -DDEFAULT_SYSROOT=../sysroot",
            "*:aarch64-linux-android:config_opts=$config_opts -DLLVM_TARGETS_TO_BUILD=AArch64 -DLLVM_DEFAULT_TARGET_TRIPLE=aarch64-linux-android",
            "*:x86_64-linux-android:config_opts=$config_opts -DLLVM_TARGETS_TO_BUILD=X86 -DLLVM_DEFAULT_TARGET_TRIPLE=x86_64-linux-android",
            "*:armv7a-linux-androideabi:config_opts=$config_opts -DLLVM_TARGETS_TO_BUILD=ARM -DLLVM_DEFAULT_TARGET_TRIPLE=armv7a-linux-androideabi",
            "linux_amd64:*-android*:config_opts=$config_opts -DLLVM_HOST_TRIPLE=x86_64-linux-gnu",
            "linux_arm64:*-android*:config_opts=$config_opts -DLLVM_HOST_TRIPLE=aarch64-linux-gnu",
            "darwin_arm64:*-android*:config_opts=$config_opts -DLLVM_HOST_TRIPLE=aarch64-apple-darwin",
            "darwin_*:*-android*:MACOSX_DEPLOYMENT_TARGET=13.0",
            "darwin_arm64:*-android*:SDK_VERSION=26.1",
            "darwin_arm64:*-android*:SDK_PATH=$NATIVEPREFIX/_/SDK/MacOSX26.1.sdk",
            "darwin_arm64:*-android*:SDKROOT=$NATIVEPREFIX/_/SDK/MacOSX26.1.sdk",
            "darwin_*:*-android*:config_opts=$config_opts -DCMAKE_OSX_SYSROOT=$SDK_PATH",
            "darwin_*:*-android*:config_opts=$config_opts -DCMAKE_OSX_DEPLOYMENT_TARGET=13.0",
            "darwin_*:*-android*:config_opts=$config_opts -DCMAKE_LIBTOOL=$NATIVEPREFIX/_/bin/llvm-libtool-darwin",
            "linux_*:*-android*:config_opts=$config_opts -DLLVM_ENABLE_LIBCXX=ON",
            "linux_*:*-android*:config_opts=$config_opts -DCMAKE_C_COMPILER=$NATIVEPREFIX/_/bin/clang",
            "linux_*:*-android*:config_opts=$config_opts -DCMAKE_CXX_COMPILER=$NATIVEPREFIX/_/bin/clang++",
            "linux_*:*-android*:CMAKE_CXX_FLAGS=-stdlib=libc++ -I$NATIVEPREFIX/include/c++/v1",
            "linux_*:*-android*:CMAKE_EXE_LINKER_FLAGS=-L$NATIVEPREFIX/lib -stdlib=libc++ -lc++ -lc++abi -lunwind -latomic -Wl,-rpath,$NATIVEPREFIX/lib",
            "linux_*:*-android*:CMAKE_SHARED_LINKER_FLAGS=-L$NATIVEPREFIX/lib -stdlib=libc++ -lc++ -lc++abi -lunwind -Wl,-rpath,$NATIVEPREFIX/lib",
            "darwin_*:*-android*:config_opts=$config_opts -DCMAKE_C_COMPILER=$NATIVEPREFIX/_/bin/clang",
            "darwin_*:*-android*:config_opts=$config_opts -DCMAKE_CXX_COMPILER=$NATIVEPREFIX/_/bin/clang++",
            "darwin_*:*-android*:config_opts=$config_opts -DCMAKE_IGNORE_PREFIX_PATH=/opt/homebrew",
            "darwin_*:*-android*:CMAKE_CXX_FLAGS=-stdlib=libc++ -I$NATIVEPREFIX/include/c++/v1",
            "darwin_*:*-android*:CMAKE_EXE_LINKER_FLAGS=-nostdlib++ -L$NATIVEPREFIX/lib -lc++ -lc++abi -lunwind",
            "darwin_*:*-android*:CMAKE_SHARED_LINKER_FLAGS=-nostdlib++ -L$NATIVEPREFIX/lib -lc++ -lc++abi -lunwind"
        ],
        "steps": [
            "linux_*:*-android*:cmake $config_opts -DCMAKE_CXX_FLAGS=\"$CMAKE_CXX_FLAGS\" -DCMAKE_EXE_LINKER_FLAGS=\"$CMAKE_EXE_LINKER_FLAGS\" -DCMAKE_SHARED_LINKER_FLAGS=\"$CMAKE_SHARED_LINKER_FLAGS\"",
            "darwin_*:*-android*:cp -f $PATCH_DIR/rust-std/xcrun $NATIVEPREFIX/bin/xcrun",
            "darwin_*:*-android*:chmod +x $NATIVEPREFIX/bin/xcrun",
            "darwin_*:*-android*:printf '#!/bin/sh\\ncase \"$1\" in\\n  -productVersion) echo %s ;;\\n  *) echo %s ;;\\nesac\\n' \"$SDK_VERSION\" \"$SDK_VERSION\" > $NATIVEPREFIX/bin/sw_vers",
            "darwin_*:*-android*:chmod +x $NATIVEPREFIX/bin/sw_vers",
            "darwin_*:*-android*:cmake $config_opts -DCMAKE_CXX_FLAGS=\"$CMAKE_CXX_FLAGS\" -DCMAKE_EXE_LINKER_FLAGS=\"$CMAKE_EXE_LINKER_FLAGS\" -DCMAKE_SHARED_LINKER_FLAGS=\"$CMAKE_SHARED_LINKER_FLAGS\"",
            "*:*-android*:DESTDIR=$STAGING_DIR cmake --build build --target install -j$NUM_CORES"
        ]
    }
}