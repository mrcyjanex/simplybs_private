{
    "package": "native/android_ndk",
    "version": "r28c",
    "type": "native",
    "dependencies": [
        "*:*-android*:native/_/_",
        "*:*-android*:native/android-clang",
        "*:*-android*:native/android-runtimes",
        "*:*-android*:native/android-sysroot",
        "*:*-android*:native/bash",
        "*:*-android*:native/libc++",
        "*:*-android*:native/python@3.11"
    ],
    "build": {
        "env": [
            "linux_amd64:*-android*:ANDROID_HOST_TAG=linux-x86_64",
            "linux_arm64:*-android*:ANDROID_HOST_TAG=linux-aarch64",
            "darwin_arm64:*-android*:ANDROID_HOST_TAG=darwin-arm64",
            "*:aarch64-linux-android:BUILDLIB_HOST=aarch64-linux-android",
            "*:x86_64-linux-android:BUILDLIB_HOST=x86_64-linux-android",
            "*:armv7a-linux-androideabi:BUILDLIB_HOST=armv7a-linux-androideabi",
            "*:*-android*:API_LEVEL=21"
        ],
        "steps": [
            "*:*-android*:python3 $PATCH_DIR/ndk-assemble install --skeleton $NATIVEPREFIX/android-ndk-skeleton --clang-prefix $NATIVEPREFIX/android-clang --runtimes $NATIVEPREFIX/android-runtimes --ndk-out $STAGING_DIR$NATIVEPREFIX --host-tag $ANDROID_HOST_TAG --host-lib-dir $NATIVEPREFIX/lib --prefix-lib-dir $STAGING_DIR$PREFIX/lib --target-triple $BUILDLIB_HOST --api $API_LEVEL",
            "*:*-android*:python3 $PATCH_DIR/android_ndk/symlink_same.py $STAGING_DIR$PREFIX",
            "*:*-android*:python3 $PATCH_DIR/ndk-assemble smoke-test --ndk $STAGING_DIR$NATIVEPREFIX --host-tag $ANDROID_HOST_TAG --target-triple $BUILDLIB_HOST --api $API_LEVEL"
        ]
    }
}