{
    "package": "native/android-runtimes",
    "version": "21.1.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "450f52eec88f728c89a9efd667dbeaf2dad93826",
            "url": "https://github.com/llvm/llvm-project"
        }
    ],
    "dependencies": [
        "*:*-android*:native/_/_",
        "*:*-android*:native/android-clang",
        "*:*-android*:native/android-sysroot",
        "*:*-android*:native/bash",
        "*:*-android*:native/cmake",
        "*:*-android*:native/libc++",
        "*:*-android*:native/ninja",
        "*:*-android*:native/python@3.11"
    ],
    "build": {
        "env": [
            "linux_amd64:*-android*:ANDROID_HOST_TAG=linux-x86_64",
            "linux_arm64:*-android*:ANDROID_HOST_TAG=linux-aarch64",
            "darwin_arm64:*-android*:ANDROID_HOST_TAG=darwin-arm64",
            "*:aarch64-linux-android:NDK_ABI=arm64-v8a",
            "*:x86_64-linux-android:NDK_ABI=x86_64",
            "*:armv7a-linux-androideabi:NDK_ABI=armeabi-v7a",
            "*:*-android*:API_LEVEL=21"
        ],
        "steps": [
            "*:*-android*:python3 $PATCH_DIR/ndk-assemble build-runtimes --llvm-src $PWD --clang-prefix $NATIVEPREFIX/android-clang --sysroot $NATIVEPREFIX/android-ndk-skeleton/toolchains/llvm/prebuilt/$ANDROID_HOST_TAG/sysroot --output $STAGING_DIR$NATIVEPREFIX/android-runtimes --api $API_LEVEL --abis $NDK_ABI --jobs $NUM_CORES"
        ]
    }
}